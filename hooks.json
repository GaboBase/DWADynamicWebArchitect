{
  "dwa-boundary-guard": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/dwa-boundary-guard.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
