{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DWA: Audit Architecture (DAG, Naming, Density, Security)",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/bin/dwa.cjs", "audit", "${workspaceFolder}"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "DWA: Sync Manifest & ARCHITECTURE.md",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}/bin/dwa.cjs", "sync", "${workspaceFolder}"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
