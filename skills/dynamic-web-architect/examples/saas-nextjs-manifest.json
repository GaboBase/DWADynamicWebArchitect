{
  "$schema": "https://dynamic-web-architect.dev/schemas/architecture-manifest.schema.json",
  "schemaVersion": "2.0.0",
  "project": "mediflow-clinic-saas",
  "description": "Clinical SaaS portal with patient records, scheduling, billing, and Gemini AI triage assistant.",
  "pattern": "feature-driven-screaming",
  "complexityLevel": "high",
  "complexityScores": {
    "presentation": 4,
    "domainComplexity": 4,
    "dataAndState": 4,
    "securityAndCompliance": 5,
    "multiAppScale": 3,
    "backendAutonomy": 3
  },
  "stack": {
    "framework": "nextjs-app-router",
    "language": "typescript",
    "runtime": "node>=18",
    "packageManager": "npm",
    "aiSdk": "@google/genai"
  },
  "routingShell": {
    "enabled": true,
    "directory": "src/app",
    "rule": "Keep src/app strictly as thin routing/layout composition; delegate state, components, and services to domain features."
  },
  "pathAliases": {
    "@/*": "./src/*"
  },
  "boundaries": {
    "routingShell": "src/app",
    "domainModules": "src/features",
    "sharedPrimitives": "src/shared",
    "coreInfrastructure": "src/core"
  },
  "importRules": {
    "src/shared": ["none"],
    "src/core": ["src/shared"],
    "src/features/*": ["src/shared", "src/core"],
    "src/app": ["src/features/*", "src/shared", "src/core"]
  },
  "namingConventions": {
    "directories": "kebab-case (e.g., user-profile/, billing-history/)",
    "components": "PascalCase (e.g., UserCard.tsx, PaymentModal.vue)",
    "hooks": "camelCase with mandatory use prefix (e.g., useAuthSession.ts)",
    "services": "kebab-case with .service.<ext> or .api.<ext> suffix (e.g., checkout.service.ts)",
    "useCases": "kebab-case with .use-case.<ext> suffix (e.g., process-payment.use-case.ts)",
    "schemas": "kebab-case with .schema.<ext> suffix (e.g., order.schema.ts)",
    "types": "kebab-case with .types.<ext> suffix (e.g., customer.types.ts)",
    "utils": "kebab-case with .util.<ext> suffix (e.g., format-currency.util.ts)",
    "tests": "co-located *.test.<ext> or *.spec.<ext> next to subject under test"
  },
  "barrelPolicy": {
    "mode": "feature-public-api-only",
    "allowedPaths": ["src/features/*/index.ts"],
    "forbiddenPaths": ["src/shared/ui/index.*", "src/features/*/components/index.*"]
  },
  "securityProfile": {
    "level": "regulated",
    "verticalHints": ["healthcare", "saas"],
    "serverOnlyModules": ["src/core/ai"],
    "forbiddenClientImports": ["@google/genai", "pg", "prisma", "@prisma/client", "stripe"]
  },
  "maxLooseFilesPerDirectory": 10,
  "promotionThreshold": 2,
  "activeFeatures": ["auth", "patients", "appointments", "billing", "ai-assistant"],
  "evolution": {
    "nextRecommendedPattern": "monorepo-workspaces",
    "migrationTriggers": [
      "A second deployable app (e.g., mobile clinician app or dedicated billing API) shares domain contracts or UI"
    ]
  }
}
